# Прод и локальный прогон через OpenRouter. Ключ не коммитить.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=

# Для локали с Claude Agent SDK: LLM_PROVIDER=claude_sdk (в прод-образе CLI нет).
LLM_MODEL=claude-haiku-4-5

# OpenRouter OpenAI-совместимые аудио-ручки (не self-hosted stt/tts).
STT_BASE_URL=https://openrouter.ai/api/v1
TTS_BASE_URL=https://openrouter.ai/api/v1
# Локально тот же ключ, что OPENROUTER_API_KEY; в деплое workflow подставляет секрет.
STT_API_KEY=
TTS_API_KEY=
STT_MODEL=whisper-1
# У livekit-plugins-openai STT language по умолчанию "en" — без явного "ru" сервер
# честно транскрибирует русскую речь как английскую (проверено вживую).
STT_LANGUAGE=ru
TTS_MODEL=fish-audio/s1
# LiveKit openai.TTS иначе подставит voice=ash — OpenRouter fish-audio/s1 отвечает 400.
# alloy проверен 2026-09-06. Не pushkin (id папки старого self-hosted Fish Speech).
TTS_VOICE=alloy
# Запас TTS (не включать по умолчанию): google/gemini-3.1-flash-tts-preview, voice Kore, только pcm.

# Мок-данные для интервью (см. mock_data/interview_example.json) — используются только
# когда имя комнаты LiveKit не похоже на реальный UUID интервью (локальные/ручные прогоны:
# console, scripts/simulate.py, mock_driver.py). Для реальной комнаты с UUID-именем
# вопросы тянутся с backend (BACKEND_BASE_URL/LIVE_AGENT_TOKEN ниже) — см. agent.py,
# _load_interview_input().
MOCK_INTERVIEW_PATH=mock_data/interview_example.json

# Backend, откуда live-agent тянет реальный InterviewInput (вакансия/вопросы) по UUID
# комнаты — GET {BACKEND_BASE_URL}/api/v1/interviews/{room_name}/live-input. Внутри
# docker-сети — имя сервиса backend (http://backend:8000), как REDIS_URL/LIVEKIT_URL уже
# используют имена сервисов, а не localhost. LIVE_AGENT_TOKEN — общий с backend секрет,
# посылается в заголовке X-Live-Agent-Token; значение ДОЛЖНО совпадать с тем, что настроено
# на backend (см. backend LIVE_AGENT_TOKEN/live_agent_token) — этот эндпоинт отдаёт
# reference_answer (ключи ответов), поэтому без совпадающего секрета не работает.
BACKEND_BASE_URL=http://backend:8000
# local-only default, не для прода.
LIVE_AGENT_TOKEN=development-live-agent-token

# Нужно только для `start`/`dev` (реальный LiveKit-воркер в комнате) — не для `console`.
# Значения ниже — local-only, совпадают с infra/docker-compose.yml; деплой пишет другие.
LIVEKIT_URL=ws://localhost:3907
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
