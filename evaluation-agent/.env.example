REDIS_URL=redis://localhost:6379/0
# Use http://backend:8000 when running from the root Docker Compose stack.
BACKEND_URL=http://localhost:8000
BACKEND_SERVICE_TOKEN=dev-evaluation-token
STT_BASE_URL=http://localhost:8003/v1
# Evaluation provider: claude (default), kimi, or dummygpt. DummyGPT never calls an API;
# it produces a deterministic mock review from the question and transcript.
EVALUATION_LLM_PROVIDER=claude
LLM_MODEL=claude-opus-5
# В отличие от live-agent (claude-haiku-4-5, латентность важнее) — здесь латентности нет,
# оценка по рубрике должна быть максимально качественной, не быстрой.

# Used only with EVALUATION_LLM_PROVIDER=kimi. kimi-k2.6 is the lightest current
# general-purpose Kimi model selected for evaluation.
KIMI_MODEL=kimi-k2.6
MOONSHOT_API_KEY=
