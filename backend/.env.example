CORS_ORIGINS=["http://localhost:3000"]
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-for-dev
DATABASE_URL=postgresql+asyncpg://ainterviewer:ainterviewer@localhost:5432/ainterviewer
JWT_SECRET=change-me-for-jwt
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Нужны только для полного multi-service compose из корня (docker-compose.yml → include:
# backend/docker-compose.yml с postgres/minio/celery) — НЕ для локального dev baseline
# (docker-compose.dev.yml, см. корневой README.md), тому достаточно CORS_ORIGINS выше.
POSTGRES_DB=ainterviewer
POSTGRES_HOST=localhost
POSTGRES_USER=ainterviewer
POSTGRES_PASSWORD=ainterviewer
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MINIO_ROOT_USER=ainterviewer
MINIO_ROOT_PASSWORD=ainterviewer123
MINIO_BUCKET=ainterviewer-resumes
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ainterviewer
S3_SECRET_KEY=ainterviewer123
