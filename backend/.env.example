CORS_ORIGINS=["http://localhost:3000"]

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev-secret-change-me
JWT_SECRET=change-me-for-jwt
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret для `GET /api/v1/interviews/{id}/live-input` (service-to-service, `live-agent`
# отправляет его в заголовке X-Live-Agent-Token) — тот же секрет должен быть в live-agent/.env.
LIVE_AGENT_TOKEN=change-me-for-live-agent

# Ничего из блока ниже не используется приложением при старте (только объявлено в
# Settings) — но все поля обязательны (без default в app/config.py), поэтому без них
# `Settings()` падает на импорте с ValidationError и backend не стартует вообще, даже
# на dev baseline (docker-compose.dev.yml), который сам эти сервисы не поднимает.
# Хостнеймы ниже — под infra/docker-compose.yml (сервисы postgres/redis/minio); если
# используешь backend/docker-compose.yml (свои db/redis/minio), поменяй *_HOST на "db"
# и т.д. под те имена сервисов.

# PostgreSQL
POSTGRES_DB=ainterviewer
POSTGRES_HOST=postgres
POSTGRES_USER=ainterviewer
POSTGRES_PASSWORD=ainterviewer
DATABASE_URL=postgresql+asyncpg://ainterviewer:ainterviewer@postgres:5432/ainterviewer

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO / S3
MINIO_ROOT_USER=ainterviewer
MINIO_ROOT_PASSWORD=ainterviewer123
MINIO_BUCKET=ainterviewer-resumes
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:3903
S3_ACCESS_KEY=ainterviewer
S3_SECRET_KEY=ainterviewer123
S3_BUCKET=ainterviewer-resumes
S3_REGION=us-east-1

# LiveKit (specs/004-candidate-interview-flow) — dev-ключи, совпадают с
# infra/docker-compose.yml LIVEKIT_KEYS. Не для прода.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-32-characters
LIVEKIT_WS_URL=ws://localhost:3907

# Публичный URL фронтенда — используется для сборки кандидатской ссылки, которую
# рекрутёр получает при создании интервью (`{PUBLIC_FRONTEND_URL}/interview/{access_token}`).
PUBLIC_FRONTEND_URL=http://localhost:3000

# Модель для генерации вопросов вакансии (app/services/vacancy_llm_service.py) — Claude
# Agent SDK на подписке, НЕ Anthropic API-ключ. Требует, чтобы на хосте был выполнен
# `claude login` (интерактивно, разово) — креды читаются volume-mount'ом на `~/.claude`
# (см. docker-compose.dev.yml, CLAUDE_CONFIG_DIR), сам login в контейнере не делается.
LLM_MODEL=claude-sonnet-5
